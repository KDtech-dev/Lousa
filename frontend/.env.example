# API is the safe default. Use `demo` only for isolated local development.
VITE_LOUSA_MODE=api
VITE_LOUSA_API_BASE_URL=

# Provisional Laravel contract paths. Leave blank until confirmed by the backend team.
VITE_LOUSA_API_LOGIN_PATH=
VITE_LOUSA_API_CURRENT_USER_PATH=
VITE_LOUSA_API_LOGOUT_PATH=
VITE_LOUSA_API_DASHBOARD_PATH=
VITE_LOUSA_API_ACTIVITIES_PATH=
VITE_LOUSA_API_MATERIALS_PATH=
VITE_LOUSA_API_GENERATE_PROMPT_PATH=
VITE_LOUSA_API_GENERATE_MATERIAL_PATH=

# Optional session CSRF setup path, if required by the Laravel authentication contract.
VITE_LOUSA_API_CSRF_PATH=
